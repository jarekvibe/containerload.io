# Netlify-Header fuer containerload.io
#
# Format: Eine Zeile die mit / beginnt ist ein Pfadmuster.
# Die eingerueckten Zeilen darunter sind die Header fuer diesen Pfad.
#
# WICHTIG bei Aenderungen: Wenn hier ein fremder Server fehlt, der irgendwo
# nachgeladen wird, blockiert der Browser ihn stillschweigend. Die Seite sieht
# dann kaputt aus, ohne Fehlermeldung. Vor dem Hinzufuegen einer neuen
# Bibliothek also immer auch hier eintragen.

/*
  # Content-Security-Policy: Sagt dem Browser, von welchen Servern er ueberhaupt
  # etwas laden darf. Alles was hier nicht steht, wird blockiert.
  #
  # Seit November 2026 liefert die Seite Tailwind (tailwind.css), React und Three.js
  # (vendor/) und die Schriften (schrift/) SELBST aus. Uebrig sind genau zwei fremde
  # Adressen:
  #
  #   gc.zgo.at            -> Besucherzaehler GoatCounter (das Skript)
  #   *.goatcounter.com    -> Besucherzaehler (wohin gezaehlt wird)
  #   app.netlify.com      -> NUR die Vorschau-Leiste, die Netlify in Deploy-Previews
  #                           einblendet. Auf der Live-Seite gibt es sie nicht. Ohne
  #                           diesen Eintrag meldet jede Vorschau einen CSP-Fehler,
  #                           und echte Fehler gehen daneben unter.
  #
  # Vorher standen hier zusaetzlich cdn.tailwindcss.com, cdnjs.cloudflare.com,
  # fonts.googleapis.com und fonts.gstatic.com. Wer wieder etwas von dort (oder von
  # irgendeinem anderen fremden Server) nachlaedt, muss es hier eintragen -- und
  # test/eigene-dateien.test.mjs anpassen, der genau das festhaelt.
  #
  # 'unsafe-inline' ist noetig, weil das Projekt bewusst ohne Build-Schritt
  # arbeitet: der gesamte Code steht direkt in den HTML-Dateien.
  # data: und blob: bei img-src brauchen der PNG-Export und die QR-Codes.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://containerload.goatcounter.com; connect-src 'self' https://containerload.goatcounter.com; worker-src 'self' blob:; frame-src 'self' https://app.netlify.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

  # Fremde Seiten duerfen ContainerLoad nicht in einen Rahmen einbetten.
  # SAMEORIGIN statt DENY: die eigene Seite darf den Rechner einbetten (der
  # Rechner kennt den eingebetteten Zustand), fremde Seiten duerfen es nicht.
  X-Frame-Options: SAMEORIGIN

  # Der Browser soll Dateitypen nicht raten, sondern nehmen was der Server sagt.
  X-Content-Type-Options: nosniff

  # Beim Wechsel auf eine fremde Seite wird nur die Domain mitgegeben,
  # nicht die genaue Adresse (in der ja eine geteilte Ladung stecken kann).
  Referrer-Policy: strict-origin-when-cross-origin

  # Kamera, Mikrofon und Standort werden nie gebraucht - also komplett abschalten.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Standard: bei jedem Aufruf nachfragen, ob es etwas Neues gibt.
  # Das Projekt hat keinen Build-Schritt, die Dateinamen aendern sich also nie.
  # Ein langer Cache wuerde bedeuten, dass eine Korrektur tagelang nicht ankommt.
  Cache-Control: public, max-age=0, must-revalidate

# Bilder und Symbole aendern sich selten. Ein Tag Zwischenspeicher ist ein guter
# Kompromiss: schnell fuer Wiederkehrer, aber eine Korrektur ist morgen sichtbar.
# Bewusst KEIN "immutable" - das wuerde ein Jahr lang jede Aenderung aussperren.
/*.png
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=86400

# Bibliotheken und Schriftdateien tragen ihre Version im Dateinamen
# (react-18.3.1..., archivo-5.3.0-latin.woff2). Eine neue Version ist eine neue
# Datei -- der Inhalt hinter einem Namen aendert sich nie. Deshalb duerfen sie
# lange im Browser bleiben; das gilt ausdruecklich NICHT fuer schrift.css und
# tailwind.css, deren Namen gleich bleiben.
/vendor/*.js
  Cache-Control: public, max-age=31536000, immutable

/schrift/*.woff2
  Cache-Control: public, max-age=31536000, immutable
