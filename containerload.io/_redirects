# Alte .html-Pfade -> saubere Pfade (301, force weil Dateien existieren)
/index.html        /              301!
/app.html          /app           301!
/share.html        /share         301!
/impressum.html    /impressum     301!
/datenschutz.html  /datenschutz   301!
/admin.html        /admin         301!

# Saubere Pfade intern auf die Dateien mappen (200 = Rewrite, URL bleibt)
/app           /app.html           200
/share         /share.html         200
/impressum     /impressum.html     200
/datenschutz   /datenschutz.html   200
/admin         /admin.html         200

# Partner-Rechner (Speditionen mit eigenem Logo): /p/<kunde> -> partner/index.html.
# Der Kunde steht in partner/partners.json; die Seite liest den Slug aus dem Pfad.
/p/*                 /partner/index.html     200

# Ratgeber (SEO Long-Tail): saubere Pfade -> Dateien. 200 = Rewrite (Query-Strings bleiben erhalten).
# Echte .html-Dateien werden weiterhin direkt ausgeliefert (Rewrites ohne ! haben niedrigere Prio).
/ratgeber            /ratgeber/index.html    200
/ratgeber/           /ratgeber/index.html    200
/ratgeber/:slug      /ratgeber/:slug.html    200

# Container Guide (englische Fassung des Container-Wissens). Eigene Adressen statt
# ?lang=en: es sind eigene Dateien mit eigenen Titeln, und Google soll sie als solche
# indexieren. Die Verknuepfung macht hreflang, nicht der Pfad.
/en/guide            /en/guide/index.html    200
/en/guide/           /en/guide/index.html    200
/en/guide/:slug      /en/guide/:slug.html    200
