# Englische Startseite: seit 20.11.26 eine eigene Datei unter /en/ (erzeugt aus index.html
# von werkzeug/startseite-en.mjs). Die alte Adresse /?lang=en zeigt mit 301 dorthin. Netlify
# kann den WERT eines Parameters nicht pruefen, nur sein Vorhandensein -- deshalb der
# Platzhalter (?lang=en -> /en/). Force (!), weil / eine Datei hat. Ein Rueckfall steht im
# Skript der Startseite. Netlify haengt die Abfrage an (/en/?lang=en -- die Seite raeumt sie
# selbst weg). Fuer ?lang=de ist /de/ deshalb KEINE Umleitung auf / (die bekaeme ?lang=de
# mit und liefe im Kreis), sondern die Datei de/index.html, die ohne Parameter zurueckschickt.
/        lang=:lang   /:lang/   301!

# Alte .html-Pfade -> saubere Pfade (301, force weil Dateien existieren)
/index.html        /              301!
/app.html          /app           301!
/share.html        /share         301!
/impressum.html    /impressum     301!
/datenschutz.html  /datenschutz   301!
/admin.html        /admin         301!

# Umbenannte Ratgeber-Seiten (vor den :slug-Rewrites unten, sonst fange die zuerst).
# 20.11.26: die LKW-Seite heisst nach dem, wonach gesucht wird -- "Lademeter-Rechner".
/ratgeber/ladungsberechnung-lkw-planensattel        /ratgeber/lademeter-rechner              301
/ratgeber/ladungsberechnung-lkw-planensattel.html   /ratgeber/lademeter-rechner              301
/en/guide/truck-trailer-load-calculation            /en/guide/loading-metre-calculator       301
/en/guide/truck-trailer-load-calculation.html       /en/guide/loading-metre-calculator       301

# Saubere Pfade intern auf die Dateien mappen (200 = Rewrite, URL bleibt)
/app           /app.html           200
/share         /share.html         200
# Die Teilen-Seite je Sprache (/en/share, /es/share ...): eigene Dateien mit eigener
# Vorschau-Karte, erzeugt von werkzeug/teilen-seiten.mjs. Der Rechner gibt jeden Link, der
# nicht deutsch ist, ueber diese Adresse heraus.
/:lang/share   /:lang/share.html   200
/impressum     /impressum.html     200
/datenschutz   /datenschutz.html   200
/admin         /admin.html         200

# Ratgeber (SEO Long-Tail): saubere Pfade -> Dateien. 200 = Rewrite (Query-Strings bleiben erhalten).
# Echte .html-Dateien werden weiterhin direkt ausgeliefert (Rewrites ohne ! haben niedrigere Prio).
/ratgeber            /ratgeber/index.html    200
/ratgeber/           /ratgeber/index.html    200
/ratgeber/:slug      /ratgeber/:slug.html    200

# Container Guide (englische Fassung des Container-Wissens). Eigene Adressen statt
# ?lang=en: es sind eigene Dateien mit eigenen Titeln, und Google soll sie als solche
# indexieren. Die Verknuepfung macht hreflang, nicht der Pfad.
/en/guide            /en/guide/index.html    200
/en/guide/           /en/guide/index.html    200
/en/guide/:slug      /en/guide/:slug.html    200
